# Bytecode, caches, and local Python environments
__pycache__/
*.py[cod]
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Real credentials and local state must never enter a published image
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
group_vars/
inventories/
ansible.cfg
*.vault

# Git, notebooks, test data, and local output are not runtime source
.git/
.github/
.vscode/
.idea/
notebooks/
tests/
reports/
artifacts/
*.ipynb
*.log

# Container metadata
Dockerfile
docker-compose.yml
